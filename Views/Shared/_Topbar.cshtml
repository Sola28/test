<header class="topbar">
  <button class="menu-button" aria-label="Open menu" id="menuButton">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 5h16M4 12h16M4 19h16"/>
    </svg>
  </button>

  <div class="search">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>
    </svg>
    <input placeholder="Search patient, order, or accession…" />
    <kbd>⌘ K</kbd>
  </div>

  <div class="top-actions">
    <div class="sync"><span></span> All systems operational</div>
    <button class="icon-button" aria-label="Notifications">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10.268 21a2 2 0 0 0 3.464 0"/>
        <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>
      </svg>
      <i>3</i>
    </button>

    @if (User?.Identity?.IsAuthenticated == true)
    {
      var name = User.Identity!.Name ?? "user";
      var initials = name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
      <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
        @Html.AntiForgeryToken()
        <button class="profile" type="submit" title="Sign out" style="background:none;border:0;cursor:pointer">
          <span>@initials</span>
          <div><strong>@name</strong><small>Sign out</small></div>
        </button>
      </form>
    }
    else
    {
      <a asp-controller="Account" asp-action="Login" class="profile" style="text-decoration:none">
        <span>?</span>
        <div><strong>Sign in</strong><small>Not authenticated</small></div>
      </a>
    }
  </div>
</header>